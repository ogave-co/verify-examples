# Copy to .env (next to this file, outside public/) or set real environment variables instead.
# Your platform URL; the API lives at BASE_URL + /v1
BASE_URL=https://app.ogave.co
# test_ keys send nothing (code is always 123456); live_ keys send real SMS. Keep this file out of git.
API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: seconds before "Resend" is enabled (match your Verify app's resend cooldown)
RESEND_COOLDOWN=30
# Optional: set to true when served over HTTPS
SECURE_COOKIES=false
# Optional: where the demo stores users (default: data/users.json, outside public/)
# USERS_FILE=/path/to/users.json
